## xAI / Grok (dormant -- not currently used, see GROQ_* below)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

## Groq Cloud (NOT xAI/Grok -- different company. gsk_ prefix keys, api.groq.com)
## Up to three keys for round-robin against free-tier rate limits.
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_BASE_URL=https://api.groq.com/openai/v1

## Sarvam (Hindi/Hinglish voice)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

## Gateway security -- required as the X-API-Key header on every /cases* request.
## Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=

## Datastores
DATABASE_URL=postgresql://claimsaathi:claimsaathi@localhost:5433/claimsaathi
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

## Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

## Phone-OTP auth (services/gateway/otp.py). Real MSG91 account needed for
## production SMS -- MSG91_AUTH_KEY/MSG91_OTP_TEMPLATE_ID both come from the
## MSG91 dashboard. Without them, ALLOW_DEV_OTP=true is required or every
## /auth/request-otp call fails loudly (never silently -- see otp.py).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
ALLOW_DEV_OTP=false

## WhatsApp Business API (Meta Cloud API). TOKEN/PHONE_NUMBER_ID come from a
## real WhatsApp Business Account (Meta App Dashboard). VERIFY_TOKEN is any
## string you choose yourself (used in the webhook verification handshake).
## APP_SECRET is from the same Meta app -- used to verify X-Hub-Signature-256
## on every webhook POST so a fake payload can't be injected.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

## Object storage (India region)
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=
